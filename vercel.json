{
  "framework": "vite",
  "fluid": true,
  "rewrites": [
    {
      "source": "/((?!api\\/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-sources",
      "schedule": "0 2 * * *"
    }
  ]
}
